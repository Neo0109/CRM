{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Sourcing Report",
  "type": "object",
  "required": ["report_date", "summary", "insights", "push_pool", "watch_pool", "drop_pool"],
  "properties": {
    "report_date": { "type": "string", "format": "date" },
    "summary": { "type": "string" },
    "insights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "push_pool": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportLead" }
    },
    "watch_pool": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportLead" }
    },
    "drop_pool": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportLead" }
    }
  },
  "$defs": {
    "contactMethod": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["微信/QQ", "Email", "电话", "官网", "Steam", "Discord", "B站", "X/Twitter", "其他"]
        },
        "value": { "type": "string" },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "reportLead": {
      "type": "object",
      "required": [
        "project",
        "country",
        "bucket",
        "stage",
        "priority",
        "progress",
        "publisher_status",
        "contact_methods",
        "bilibili_fit",
        "amplification",
        "verdict",
        "first_seen"
      ],
      "properties": {
        "id": { "type": "string" },
        "project": { "type": "string" },
        "steam_app_id": { "type": ["string", "null"] },
        "team": { "type": ["string", "null"] },
        "team_size": { "type": ["string", "null"] },
        "country": { "type": "string" },
        "region": { "type": "string", "enum": ["中国", "海外"] },
        "city": { "type": ["string", "null"] },
        "region_priority": {
          "type": "string",
          "enum": ["国内优先", "海外-高视觉", "海外-强数据", "其他"]
        },
        "bucket": {
          "type": "string",
          "enum": ["推进池", "观察池", "淘汰池"]
        },
        "stage": {
          "type": "string",
          "enum": ["new", "watch", "active", "negotiating", "won", "rejected"]
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "priority_reason": { "type": ["string", "null"] },
        "rule_fit": { "type": ["string", "null"] },
        "genre": { "type": ["string", "null"] },
        "gameplay": { "type": ["string", "null"] },
        "progress": { "type": "string" },
        "release_window": { "type": ["string", "null"] },
        "early_access": { "type": "boolean" },
        "narrative_heavy": { "type": "boolean" },
        "india_team": { "type": "boolean" },
        "publisher_status": { "type": "string" },
        "publisher_name": { "type": ["string", "null"] },
        "china_capability_occupied": { "type": "boolean" },
        "traction_summary": { "type": ["string", "null"] },
        "public_signals": { "type": ["string", "null"] },
        "contact": { "type": ["string", "null"] },
        "contact_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contactMethod" }
        },
        "links": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exposure_trail": { "type": ["string", "null"] },
        "bilibili_fit": { "type": "string" },
        "amplification": { "type": "string" },
        "risks": { "type": ["string", "null"] },
        "verdict": { "type": "string" },
        "next_action": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "first_seen": { "type": "string", "format": "date" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
