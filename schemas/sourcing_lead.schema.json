{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Lead",
  "type": "object",
  "required": [
    "id",
    "project",
    "country",
    "region",
    "bucket",
    "stage",
    "priority",
    "progress",
    "publisher_status",
    "contact_methods",
    "bilibili_fit",
    "amplification",
    "verdict",
    "first_seen"
  ],
  "properties": {
    "id": { "type": "string" },
    "project": { "type": "string" },
    "steam_app_id": { "type": ["string", "null"] },
    "team": { "type": ["string", "null"] },
    "team_size": { "type": ["string", "null"] },
    "country": { "type": "string" },
    "region": { "type": "string", "enum": ["中国", "海外"] },
    "city": { "type": ["string", "null"] },
    "region_priority": {
      "type": "string",
      "enum": ["国内优先", "海外-高视觉", "海外-强数据", "其他"]
    },
    "bucket": {
      "type": "string",
      "enum": ["未处理", "推进池", "待评测", "测试中", "跟进中", "观察池", "淘汰池"]
    },
    "stage": {
      "type": "string",
      "enum": ["new", "watch", "active", "negotiating", "won", "rejected"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "review_status": {
      "type": "string",
      "enum": ["未处理", "已查看", "跟进中", "已淘汰"]
    },
    "reviewed_at": { "type": ["string", "null"] },
    "drop_reason": { "type": ["string", "null"] },
    "priority_reason": { "type": ["string", "null"] },
    "rule_fit": { "type": ["string", "null"] },
    "genre": { "type": ["string", "null"] },
    "gameplay": { "type": ["string", "null"] },
    "progress": { "type": "string" },
    "release_window": { "type": ["string", "null"] },
    "early_access": { "type": "boolean" },
    "narrative_heavy": { "type": "boolean" },
    "india_team": { "type": "boolean" },
    "publisher_status": { "type": "string" },
    "publisher_name": { "type": ["string", "null"] },
    "china_capability_occupied": { "type": "boolean" },
    "traction_summary": { "type": ["string", "null"] },
    "public_signals": { "type": ["string", "null"] },
    "contact": { "type": ["string", "null"] },
    "contact_methods": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contactMethod" }
    },
    "links": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exposure_trail": { "type": ["string", "null"] },
    "bilibili_fit": { "type": "string" },
    "amplification": { "type": "string" },
    "risks": { "type": ["string", "null"] },
    "verdict": { "type": "string" },
    "evaluation_grade": {
      "type": ["string", "null"],
      "enum": ["S", "A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-", null]
    },
    "evaluation_result": { "type": ["string", "null"] },
    "evaluated_at": { "type": ["string", "null"] },
    "next_action": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "due_date": { "type": ["string", "null"], "format": "date" },
    "calendar_enabled": { "type": "boolean" },
    "follow_up_interval": { "type": ["string", "null"] },
    "first_seen": { "type": "string", "format": "date" },
    "notes": { "type": ["string", "null"] }
  },
  "$defs": {
    "contactMethod": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["微信/QQ", "Email", "电话", "官网", "Steam", "Discord", "B站", "X/Twitter", "其他"]
        },
        "value": { "type": "string" },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
