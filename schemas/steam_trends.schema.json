{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steam Trends Report",
  "type": "object",
  "required": ["report_date", "summary", "items"],
  "properties": {
    "report_date": { "type": "string", "format": "date" },
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "signal", "source", "links", "bilibili_fit", "captured_at"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "steam_app_id": { "type": ["string", "null"] },
          "rank_bucket": { "type": ["string", "null"] },
          "signal": { "type": "string" },
          "source": { "type": "string" },
          "links": { "type": "array", "items": { "type": "string" } },
          "bilibili_fit": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "auto_import": { "type": "boolean" },
          "captured_at": { "type": "string" }
        }
      }
    },
    "crm_candidates": {
      "type": "array",
      "description": "适合自动写入 CRM 的 Steam 趋势候选，结构应兼容 sourcing_lead.schema.json。",
      "items": { "type": "object" }
    }
  }
}
