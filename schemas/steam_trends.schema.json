{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steam Trends Report",
  "type": "object",
  "required": ["report_date", "summary", "items"],
  "properties": {
    "report_date": { "type": "string", "format": "date" },
    "summary": { "type": "string" },
    "market_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "signal_level", "source", "link", "suggested_action", "captured_at"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "signal_level": { "enum": ["高", "中", "低"] },
          "source": { "type": "string" },
          "link": { "type": "string" },
          "suggested_action": { "type": "string" },
          "captured_at": { "type": "string" }
        }
      }
    },
    "genre_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "genre", "signal", "why_it_matters", "bd_action", "links"],
        "properties": {
          "id": { "type": "string" },
          "genre": { "type": "string" },
          "signal": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "bd_action": { "type": "string" },
          "links": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "signal", "source", "links", "bilibili_fit", "auto_import", "captured_at"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "steam_app_id": { "type": ["string", "null"] },
          "rank_bucket": { "type": ["string", "null"] },
          "signal": { "type": "string" },
          "source": { "type": "string" },
          "links": { "type": "array", "items": { "type": "string" } },
          "bilibili_fit": { "type": "string" },
          "reason": { "type": ["string", "null"] },
          "auto_import": { "type": "boolean" },
          "captured_at": { "type": "string" }
        }
      }
    },
    "crm_candidates": {
      "type": "array",
      "items": { "$ref": "./sourcing_lead.schema.json" }
    }
  }
}
