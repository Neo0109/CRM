{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neo0109/CRM/schemas/sourcing_replay_corpus.schema.json",
  "title": "Sourcing Replay Corpus Contract v1",
  "description": "Strict per-run, privacy-safe, deterministic replay corpus envelope. Normalized evaluator payload zones are explicitly open JSON values and remain subject to the recursive privacy validator.",
  "type": "object",
  "required": [
    "contract_version",
    "corpus_id",
    "report_date",
    "timezone",
    "captured_at",
    "event_name",
    "run_slot",
    "workflow_run_id",
    "run_attempt",
    "run_url",
    "input_commit_sha",
    "node_version",
    "active_production_rule_version",
    "shadow_rule_version",
    "collector_contract_version",
    "behavior_manifest",
    "behavior_contract_sha256",
    "capture_status",
    "capture_errors",
    "artifact_bindings",
    "delivery_health",
    "budgets",
    "discovery_summary",
    "evidence_catalog",
    "candidates",
    "second_pass",
    "summary",
    "integrity"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "report_date": { "$ref": "#/$defs/date" },
    "timezone": { "const": "Asia/Shanghai" },
    "captured_at": { "$ref": "#/$defs/dateTime" },
    "event_name": {
      "type": "string",
      "enum": ["schedule", "watchdog", "workflow_dispatch"]
    },
    "run_slot": {
      "type": "string",
      "enum": ["morning", "afternoon", "watchdog", "manual"]
    },
    "workflow_run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "type": "integer", "minimum": 1 },
    "run_url": { "$ref": "#/$defs/publicUrl" },
    "input_commit_sha": { "$ref": "#/$defs/gitSha" },
    "node_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "active_production_rule_version": { "type": "string", "minLength": 1 },
    "shadow_rule_version": {
      "const": "sourcing-rules-v7.3-obtainable-evidence"
    },
    "collector_contract_version": { "type": "integer", "enum": [1, 2] },
    "behavior_manifest": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/gitSha" }
    },
    "behavior_contract_sha256": { "$ref": "#/$defs/sha256" },
    "capture_status": {
      "type": "string",
      "enum": ["complete", "incomplete", "corrupt", "unreplayable"]
    },
    "capture_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/captureError" }
    },
    "artifact_bindings": { "$ref": "#/$defs/artifactBindings" },
    "delivery_health": { "$ref": "#/$defs/deliveryHealth" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "discovery_summary": { "$ref": "#/$defs/discoverySummary" },
    "evidence_catalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "second_pass": { "$ref": "#/$defs/runSecondPass" },
    "summary": { "$ref": "#/$defs/summary" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "capture_status": { "const": "complete" } },
        "required": ["capture_status"]
      },
      "then": {
        "properties": {
          "capture_errors": { "maxItems": 0 },
          "integrity": {
            "properties": {
              "status": { "const": "complete" },
              "reason_codes": { "maxItems": 0 }
            }
          }
        }
      },
      "else": {
        "properties": {
          "capture_errors": { "minItems": 1 },
          "integrity": {
            "properties": {
              "status": {
                "enum": ["incomplete", "corrupt", "unreplayable"]
              },
              "reason_codes": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "collector_contract_version": { "const": 2 } },
        "required": ["collector_contract_version"]
      },
      "then": {
        "properties": {
          "second_pass": {
            "required": ["bounded_signals"],
            "properties": {
              "selector_version": { "const": "actionability-v2" },
              "transactions": {
                "items": { "required": ["evidence_diagnostics"] }
              }
            }
          },
          "candidates": {
            "items": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "second_pass": {
                        "properties": { "eligible": { "const": true } },
                        "required": ["eligible"]
                      }
                    },
                    "required": ["second_pass"]
                  },
                  "then": {
                    "properties": {
                      "ranking_inputs": {
                        "required": ["actionable_gate_count"],
                        "properties": {
                          "actionable_gate_count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "summary": { "required": ["second_pass_outcome_counts"] }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publicUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "type": "number" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "captureError": {
      "type": "object",
      "required": ["stage", "code", "message"],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "collector",
            "schema",
            "privacy",
            "hash",
            "binding",
            "dependency",
            "second_pass",
            "publication",
            "window"
          ]
        },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifactBinding": {
      "type": "object",
      "required": [
        "path",
        "git_blob_sha",
        "payload_sha256",
        "record_count",
        "validation_status"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "git_blob_sha": { "$ref": "#/$defs/gitSha" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "record_count": { "type": "integer", "minimum": 0 },
        "validation_status": {
          "type": "string",
          "enum": ["valid", "invalid", "missing", "unavailable"]
        }
      },
      "additionalProperties": false
    },
    "replayCorpusArtifactBinding": {
      "type": "object",
      "required": [
        "path",
        "git_blob_sha",
        "payload_sha256",
        "record_count",
        "validation_status"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "git_blob_sha": {
          "oneOf": [
            { "$ref": "#/$defs/gitSha" },
            { "type": "null" }
          ]
        },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "record_count": { "type": "integer", "minimum": 0 },
        "validation_status": {
          "type": "string",
          "enum": ["valid", "invalid", "missing", "unavailable"]
        }
      },
      "additionalProperties": false
    },
    "artifactBindings": {
      "type": "object",
      "required": ["report", "sourcing_candidates", "replay_corpus", "receipt"],
      "properties": {
        "report": { "$ref": "#/$defs/artifactBinding" },
        "sourcing_candidates": { "$ref": "#/$defs/artifactBinding" },
        "replay_corpus": { "$ref": "#/$defs/replayCorpusArtifactBinding" },
        "receipt": { "$ref": "#/$defs/artifactBinding" },
        "radar": { "$ref": "#/$defs/artifactBinding" },
        "steam_trends": { "$ref": "#/$defs/artifactBinding" }
      },
      "additionalProperties": false
    },
    "deliveryHealth": {
      "type": "object",
      "required": [
        "generation_status",
        "validation_status",
        "receipt_status",
        "sync_response",
        "source_health_status",
        "failure_stage"
      ],
      "properties": {
        "generation_status": {
          "type": "string",
          "enum": ["success", "failed", "skipped"]
        },
        "validation_status": {
          "type": "string",
          "enum": ["success", "failed", "skipped"]
        },
        "receipt_status": {
          "type": "string",
          "enum": ["success", "failed", "missing"]
        },
        "sync_response": {
          "type": "object",
          "required": ["synced"],
          "properties": {
            "synced": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "source_health_status": {
          "type": "string",
          "enum": ["healthy", "degraded", "failed", "unknown"]
        },
        "failure_stage": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "budgetLimits": {
      "type": "object",
      "required": [
        "max_candidates",
        "max_steam_details",
        "new_lane",
        "backlog_lane",
        "retry_refresh_lane",
        "snapshot_ttl_days",
        "second_pass_max_candidates",
        "actions_per_candidate_min",
        "actions_per_candidate_max",
        "provider_request_limit",
        "provider_retry_limit",
        "scheduled_network_budget"
      ],
      "properties": {
        "max_candidates": { "type": "integer", "minimum": 0 },
        "max_steam_details": { "type": "integer", "minimum": 0 },
        "new_lane": { "type": "integer", "minimum": 0 },
        "backlog_lane": { "type": "integer", "minimum": 0 },
        "retry_refresh_lane": { "type": "integer", "minimum": 0 },
        "snapshot_ttl_days": { "type": "integer", "minimum": 0 },
        "second_pass_max_candidates": { "type": "integer", "minimum": 0 },
        "actions_per_candidate_min": { "type": "integer", "minimum": 0 },
        "actions_per_candidate_max": { "type": "integer", "minimum": 0 },
        "provider_request_limit": { "type": "integer", "minimum": 0 },
        "provider_retry_limit": { "type": "integer", "minimum": 0 },
        "scheduled_network_budget": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "budgetUsage": {
      "type": "object",
      "required": [
        "fresh_steam_detail_requests",
        "scheduled_network_requests",
        "reused_snapshot_count",
        "provider_requests",
        "fresh_steam_detail_candidate_ids",
        "scheduled_network_candidate_ids",
        "reused_snapshot_candidate_ids",
        "provider_transaction_ids"
      ],
      "properties": {
        "fresh_steam_detail_requests": { "type": "integer", "minimum": 0 },
        "scheduled_network_requests": { "type": "integer", "minimum": 0 },
        "reused_snapshot_count": { "type": "integer", "minimum": 0 },
        "provider_requests": { "type": "integer", "minimum": 0 },
        "fresh_steam_detail_candidate_ids": { "$ref": "#/$defs/stringArray" },
        "scheduled_network_candidate_ids": { "$ref": "#/$defs/stringArray" },
        "reused_snapshot_candidate_ids": { "$ref": "#/$defs/stringArray" },
        "provider_transaction_ids": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["limits", "usage"],
      "properties": {
        "limits": { "$ref": "#/$defs/budgetLimits" },
        "usage": { "$ref": "#/$defs/budgetUsage" }
      },
      "additionalProperties": false
    },
    "discoverySource": {
      "type": "object",
      "required": ["source_id", "raw_count", "retained_count", "failure_count"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "raw_count": { "type": "integer", "minimum": 0 },
        "retained_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "discoverySummary": {
      "type": "object",
      "required": ["decision_universe_count", "sources"],
      "properties": {
        "decision_universe_count": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/discoverySource" }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_type",
        "gate_id",
        "url",
        "source_id",
        "source_role",
        "evidence_family",
        "captured_at",
        "title",
        "normalized_summary",
        "content_sha256",
        "source_status",
        "fetch_error",
        "official_public_business_entry"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "type": "string", "minLength": 1 },
        "gate_id": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/publicUrl" },
        "source_id": { "type": "string", "minLength": 1 },
        "source_role": {
          "type": "string",
          "enum": [
            "official",
            "developer",
            "publisher",
            "media",
            "trusted_creator",
            "keyword",
            "unclassified"
          ]
        },
        "evidence_family": {
          "type": "string",
          "enum": [
            "playability",
            "product_performance",
            "external_validation",
            "early_market_signal",
            "team_execution",
            "user_feedback"
          ]
        },
        "captured_at": { "$ref": "#/$defs/dateTime" },
        "title": { "type": "string" },
        "normalized_summary": { "type": "string" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "source_status": {
          "type": "string",
          "enum": ["success", "failed", "unknown"]
        },
        "fetch_error": { "type": ["string", "null"] },
        "official_public_business_entry": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gateResult": {
      "type": "object",
      "required": ["gate_id", "status", "hard_exclusion", "evidence_ids"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "unknown"]
        },
        "hard_exclusion": { "type": "boolean" },
        "evidence_ids": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "laneEvaluation": {
      "type": "object",
      "required": ["input", "output", "gate_results"],
      "properties": {
        "input": { "$ref": "#/$defs/jsonObject" },
        "output": { "$ref": "#/$defs/jsonObject" },
        "gate_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateResult" }
        }
      },
      "additionalProperties": false
    },
    "regularSelection": {
      "type": "object",
      "required": ["status", "lane", "reason_code"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["selected", "rejected"]
        },
        "lane": {
          "type": ["string", "null"],
          "enum": ["indie_prelaunch", "china_joint", null]
        },
        "reason_code": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "firstPass": {
      "type": "object",
      "required": [
        "evaluator_dependency_sha256",
        "indie_prelaunch",
        "china_joint",
        "regular_selection"
      ],
      "properties": {
        "evaluator_dependency_sha256": { "$ref": "#/$defs/sha256" },
        "indie_prelaunch": { "$ref": "#/$defs/laneEvaluation" },
        "china_joint": { "$ref": "#/$defs/laneEvaluation" },
        "regular_selection": { "$ref": "#/$defs/regularSelection" }
      },
      "additionalProperties": false
    },
    "dedupeBoundary": {
      "type": "object",
      "required": [
        "history_match",
        "crm_preexisting_match",
        "match_basis",
        "audit_digest"
      ],
      "properties": {
        "history_match": { "type": "boolean" },
        "crm_preexisting_match": { "type": "boolean" },
        "match_basis": {
          "type": "string",
          "enum": ["none", "public_history", "private_crm", "both"]
        },
        "audit_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "candidateSecondPass": {
      "type": "object",
      "required": [
        "eligible",
        "rejection_reason",
        "selected",
        "attempted",
        "transaction_id"
      ],
      "properties": {
        "eligible": { "type": "boolean" },
        "rejection_reason": { "type": ["string", "null"] },
        "selected": { "type": "boolean" },
        "attempted": { "type": "boolean" },
        "transaction_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "decision",
        "selected_lane",
        "shadow_push_pool",
        "dedupe_suppressed",
        "shadow_lead_payload_sha256",
        "risk_flags",
        "day_lead_count_used"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["formal", "candidate", "excluded"]
        },
        "selected_lane": {
          "type": ["string", "null"],
          "enum": ["indie_prelaunch", "china_joint", null]
        },
        "shadow_push_pool": { "type": "boolean" },
        "dedupe_suppressed": { "type": "boolean" },
        "shadow_lead_payload_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "risk_flags": { "$ref": "#/$defs/stringArray" },
        "day_lead_count_used": { "const": false }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "project",
        "steam_app_id",
        "dedupe_key",
        "source_type",
        "source_lane",
        "origin_signal_ids",
        "first_seen",
        "last_seen",
        "scheduler_lane",
        "enrichment_status",
        "enrichment_attempts",
        "snapshot_status",
        "evidence_freshness",
        "normalized_candidate",
        "discovery_score",
        "ranking_inputs",
        "qualification_affected_by_ranking",
        "dedupe_boundary",
        "first_pass",
        "second_pass",
        "publication"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "steam_app_id": { "type": ["string", "null"] },
        "dedupe_key": { "type": "string", "minLength": 1 },
        "source_type": {
          "type": "string",
          "enum": ["steam", "media", "multi_source"]
        },
        "source_lane": {
          "type": "string",
          "enum": ["regular", "indie_prelaunch", "china_joint"]
        },
        "origin_signal_ids": { "$ref": "#/$defs/stringArray" },
        "first_seen": { "$ref": "#/$defs/date" },
        "last_seen": { "$ref": "#/$defs/date" },
        "scheduler_lane": {
          "type": "string",
          "enum": ["new", "backlog", "retry_refresh", "reuse", "not_applicable"]
        },
        "enrichment_status": {
          "type": "string",
          "enum": ["pending", "success", "failed", "not_applicable"]
        },
        "enrichment_attempts": { "type": "integer", "minimum": 0 },
        "snapshot_status": {
          "type": "string",
          "enum": ["fresh_success", "reused", "failed", "missing", "not_applicable"]
        },
        "evidence_freshness": {
          "type": "string",
          "enum": ["fresh", "reused", "missing", "not_applicable"]
        },
        "normalized_candidate": { "$ref": "#/$defs/jsonObject" },
        "discovery_score": { "type": "number" },
        "ranking_inputs": { "$ref": "#/$defs/jsonObject" },
        "qualification_affected_by_ranking": { "const": false },
        "dedupe_boundary": { "$ref": "#/$defs/dedupeBoundary" },
        "first_pass": { "$ref": "#/$defs/firstPass" },
        "second_pass": { "$ref": "#/$defs/candidateSecondPass" },
        "publication": { "$ref": "#/$defs/publication" }
      },
      "additionalProperties": false
    },
    "requestedAction": {
      "type": "object",
      "required": ["gate_id", "action"],
      "properties": {
        "gate_id": {
          "type": "string",
          "enum": [
            "identity_and_dedupe",
            "prelaunch_window",
            "publisher_china_capacity_clear",
            "non_narrative_product",
            "non_india_team",
            "official_playable_or_gameplay",
            "independent_quality_proof",
            "non_steam_business_entry",
            "concrete_china_bilibili_value"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "resolve_project_identity",
            "verify_prelaunch_window",
            "verify_publisher_china_capacity",
            "verify_product_focus",
            "verify_team_region",
            "fetch_official_playable_or_gameplay",
            "fetch_independent_quality_evidence",
            "fetch_non_steam_business_entry",
            "research_china_bilibili_value"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceDiagnostics": {
      "type": "object",
      "required": [
        "project_matching_signal_count",
        "eligible_source_role_signal_count",
        "quality_keyword_signal_count",
        "independent_source_count",
        "accepted_proof_count",
        "actionable_gate_count",
        "outcome"
      ],
      "properties": {
        "project_matching_signal_count": { "type": "integer", "minimum": 0 },
        "eligible_source_role_signal_count": { "type": "integer", "minimum": 0 },
        "quality_keyword_signal_count": { "type": "integer", "minimum": 0 },
        "independent_source_count": { "type": "integer", "minimum": 0 },
        "accepted_proof_count": { "type": "integer", "minimum": 0 },
        "actionable_gate_count": { "type": "integer", "minimum": 0 },
        "outcome": {
          "type": "string",
          "enum": [
            "evidence_found",
            "no_project_match",
            "source_role_rejected",
            "quality_keyword_missing",
            "insufficient_independent_sources",
            "not_requested"
          ]
        }
      },
      "additionalProperties": false
    },
    "secondPassOutcomeCounts": {
