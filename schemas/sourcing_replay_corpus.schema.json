        "no_project_match",
        "source_role_rejected",
        "quality_keyword_missing",
        "insufficient_independent_sources",
        "not_requested"
      ],
      "properties": {
        "evidence_found": { "type": "integer", "minimum": 0 },
        "no_project_match": { "type": "integer", "minimum": 0 },
        "source_role_rejected": { "type": "integer", "minimum": 0 },
        "quality_keyword_missing": { "type": "integer", "minimum": 0 },
        "insufficient_independent_sources": { "type": "integer", "minimum": 0 },
        "not_requested": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "transaction": {
      "type": "object",
      "required": [
        "transaction_id",
        "candidate_id",
        "requested_actions",
        "allowlisted_patch_fields",
        "bounded_signals",
        "provider_contract_version",
        "request_metrics",
        "raw_provider_result",
        "filtered_patch",
        "provider_status",
        "error",
        "merged_final_input",
        "final_output",
        "decision_changed",
        "changed_gate",
        "evaluator_dependency_sha256"
      ],
      "properties": {
        "transaction_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "requested_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/requestedAction" },
          "uniqueItems": true
        },
        "allowlisted_patch_fields": { "$ref": "#/$defs/stringArray" },
        "bounded_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        "provider_contract_version": { "type": "string", "minLength": 1 },
        "request_metrics": { "$ref": "#/$defs/jsonObject" },
        "raw_provider_result": {
          "oneOf": [
            { "$ref": "#/$defs/jsonObject" },
            { "type": "null" }
          ]
        },
        "filtered_patch": { "$ref": "#/$defs/jsonObject" },
        "provider_status": {
          "type": "string",
          "enum": ["success", "error", "timeout"]
        },
        "error": { "type": ["string", "null"] },
        "evidence_diagnostics": { "$ref": "#/$defs/evidenceDiagnostics" },
        "merged_final_input": { "$ref": "#/$defs/jsonObject" },
        "final_output": { "$ref": "#/$defs/jsonObject" },
        "decision_changed": { "type": "boolean" },
        "changed_gate": { "type": ["string", "null"] },
        "evaluator_dependency_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "runSecondPass": {
      "type": "object",
      "required": [
        "selector_version",
        "max_candidates",
        "eligible_ids",
        "selected_ids",
        "omitted_ids",
        "attempted_ids",
        "failed_ids",
        "qualified_ids",
        "transactions"
      ],
      "properties": {
        "selector_version": { "type": "string", "minLength": 1 },
        "max_candidates": { "type": "integer", "minimum": 0 },
        "eligible_ids": { "$ref": "#/$defs/stringArray" },
        "selected_ids": { "$ref": "#/$defs/stringArray" },
        "omitted_ids": { "$ref": "#/$defs/stringArray" },
        "attempted_ids": { "$ref": "#/$defs/stringArray" },
        "failed_ids": { "$ref": "#/$defs/stringArray" },
        "qualified_ids": { "$ref": "#/$defs/stringArray" },
        "bounded_signals": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        "transactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transaction" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "candidate_count",
        "evidence_count",
        "second_pass_eligible_count",
        "second_pass_selected_count",
        "second_pass_attempted_count",
        "second_pass_failed_count",
        "second_pass_qualified_count",
        "formal_count",
        "candidate_decision_count",
        "excluded_count",
        "shadow_push_pool_count"
      ],
      "properties": {
        "candidate_count": { "type": "integer", "minimum": 0 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "second_pass_eligible_count": { "type": "integer", "minimum": 0 },
        "second_pass_selected_count": { "type": "integer", "minimum": 0 },
        "second_pass_attempted_count": { "type": "integer", "minimum": 0 },
        "second_pass_failed_count": { "type": "integer", "minimum": 0 },
        "second_pass_qualified_count": { "type": "integer", "minimum": 0 },
        "formal_count": { "type": "integer", "minimum": 0 },
        "candidate_decision_count": { "type": "integer", "minimum": 0 },
        "excluded_count": { "type": "integer", "minimum": 0 },
        "shadow_push_pool_count": { "type": "integer", "minimum": 0 },
        "second_pass_outcome_counts": { "$ref": "#/$defs/secondPassOutcomeCounts" }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonical_json_version",
        "payload_sha256",
        "ordered_candidate_count",
        "ordered_evidence_count",
        "artifact_binding_count",
        "byte_size",
        "inline_text_characters",
        "status",
        "reason_codes"
      ],
      "properties": {
        "canonical_json_version": { "const": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "ordered_candidate_count": { "type": "integer", "minimum": 0 },
        "ordered_evidence_count": { "type": "integer", "minimum": 0 },
        "artifact_binding_count": { "type": "integer", "minimum": 0 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "inline_text_characters": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "corrupt", "unreplayable"]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "capture_error",
              "schema_invalid",
              "hash_mismatch",
              "duplicate_id",
              "count_mismatch",
              "privacy_violation",
              "behavior_mismatch",
              "missing_transaction",
              "unreplayable_dependency"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
