{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Steam Review Opportunity Delivery Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "report_date",
    "run_slot",
    "requested_mode",
    "mode",
    "sourcing_run_type",
    "status",
    "scan_complete",
    "artifact_path",
    "catalog_scan_count",
    "catalog_entries_seen",
    "qualified_count",
    "previously_qualified_count",
    "import_candidate_count",
    "deduplicated_count",
    "created_count",
    "updated_count",
    "failure_reason",
    "run_id",
    "run_number",
    "run_url",
    "head_sha",
    "captured_at",
    "sync_response"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "report_date": { "type": "string", "format": "date" },
    "run_slot": { "type": "string", "minLength": 1 },
    "requested_mode": { "type": "string", "enum": ["auto", "backfill", "scheduled"] },
    "mode": { "type": "string", "enum": ["backfill", "scheduled"] },
    "sourcing_run_type": { "type": "string", "enum": ["initial_backfill", "scheduled"] },
    "status": { "type": "string", "enum": ["success", "scan_incomplete", "sync_failed"] },
    "scan_complete": { "type": "boolean" },
    "artifact_path": { "type": "string", "pattern": "^data/steam_review_opportunities/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$" },
    "catalog_scan_count": { "type": "integer", "minimum": 0 },
    "catalog_entries_seen": { "type": "integer", "minimum": 0 },
    "qualified_count": { "type": "integer", "minimum": 0 },
    "previously_qualified_count": { "type": "integer", "minimum": 0 },
    "import_candidate_count": { "type": "integer", "minimum": 0 },
    "deduplicated_count": { "type": "integer", "minimum": 0 },
    "created_count": { "type": "integer", "minimum": 0 },
    "updated_count": { "type": "integer", "minimum": 0 },
    "failure_reason": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "run_number": { "type": ["string", "null"] },
    "run_url": { "type": ["string", "null"], "format": "uri" },
    "head_sha": { "type": ["string", "null"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "sync_response": {
      "type": "object",
      "required": ["synced"],
      "properties": {
        "synced": { "type": "boolean" },
        "created": { "type": "integer", "minimum": 0 },
        "skipped_existing": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
